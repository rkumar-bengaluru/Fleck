ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLECK_GOOGLE_MODE=gsim
# Browser-facing URLs; the api container reaches gsim as http://gsim:8090 (set in docker-compose)
FLECK_GSIM_PUBLIC_URL=http://localhost:8090
FLECK_PUBLIC_API_URL=http://localhost:8000
FLECK_WEB_URL=http://localhost:5173
FLECK_ALLOWED_DOMAINS=
FLECK_ALLOWED_EMAILS=
FLECK_LIVE_FALLBACK=claude
# Required, 32+ random chars (the api refuses to start otherwise): python -c "import secrets;print(secrets.token_urlsafe(32))"
FLECK_SECRET_KEY=
FLECK_CLAUDE_MODEL=claude-sonnet-5-5
FLECK_CLAUDE_FAST_MODEL=claude-haiku-5-5
# Your local time zone (IANA name); gsim's calendar and the server's "today" use it. Compose defaults to UTC.
TZ=Asia/Kolkata
# gsim's demo meeting start (HH:MM, local); empty = the next whole hour after gsim starts (fixed until it restarts)
GSIM_DEMO_START=
# Helper speaker gate (mic noise-floor minimum, max echo-cancelled bleed vs client) and question trigger (decision 93)
FLECK_GATE_SILENCE=0.005
FLECK_GATE_BLEED_MAX=0.3
# Empty = the threshold scripts/train_classifier.py chose (helper/fleck_helper/question_model.json, decision 94)
FLECK_TRIGGER_MIN_CONFIDENCE=
# "Used it" auto-marker: minimum cosine between a card's answer and what you said in the 15 s after it (decision 118; tuned from the brief's 0.75)
FLECK_USED_THRESHOLD=0.55
# Claude prices in USD per million tokens, JSON, to override the built-in ones: {"claude-sonnet-5-5": {"input": 2, "output": 10}}
FLECK_PRICES=
