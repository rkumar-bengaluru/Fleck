<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mic access under the hardened runtime. Screen Recording has no entitlement: macOS grants it per app through the privacy prompt. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Self-signed identity has no Team ID, so hardened-runtime library validation rejects the bundled Python dylib and extension modules. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
